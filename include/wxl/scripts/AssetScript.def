#ifndef WXL_SCRIPT_HOOK
#error "define WXL_SCRIPT_HOOK(name, params, args) before including this table"
#endif

/**
 * An ADT map chunk is being built. Raised by the wxl-modern-adt extension, not by the core: without
 * that extension loaded this hook never fires.
 *
 * @param void* chunk : the map chunk
 * @param uint32 layerCount : its texture layers
 */
WXL_SCRIPT_HOOK(OnAdtChunkBuild, (void* chunk, uint32_t layerCount), (a.chunk, a.layerCount))

/**
 * A split ADT tile finished loading its root, _tex0 and _obj0 files; main thread, after the stock
 * parser ran. Read-only. Raised by the wxl-modern-adt extension, which owns the split-tile reader,
 * not by the core: without it loaded this hook never fires.
 *
 * @param AdtSplitTileLoadArgs tile : tileFirst, tileSecond, rootSize, texSize, objSize, chunkCount
 */
WXL_SCRIPT_HOOK(OnAdtSplitTileLoad, (const events::AdtSplitTileLoadArgs& tile), (a))

/**
 * A WMO root buffer is read, before the native chunk walk: reshape it through wxl::game::wmo.
 *
 * @param void* root : the root buffer
 */
WXL_SCRIPT_HOOK(OnWmoRootLoad, (void* root), (a.root))

/**
 * A WMO group buffer is read, before the native sub-chunk walk: reshape it through wxl::game::wmo.
 *
 * @param void* group : the group buffer
 */
WXL_SCRIPT_HOOK(OnWmoGroupLoad, (void* group), (a.group))

/**
 * A texture is about to upload to the device.
 *
 * @param void* texture : the texture object
 * @param uint32 width
 * @param uint32 height
 */
WXL_SCRIPT_HOOK(OnTextureUpload, (void* texture, uint32_t width, uint32_t height), (a.texture, a.width, a.height))

/**
 * A BLP texture was requested by name; fires on every reference, cached or not. Read-only.
 *
 * @param string name : the full virtual path requested
 * @param void* handle : the resolved texture handle, null on failure
 */
WXL_SCRIPT_HOOK(OnBlpLoad, (const char* name, void* handle), (a.name, a.handle))
