#ifndef WXL_SCRIPT_HOOK
#error "define WXL_SCRIPT_HOOK(name, params, args) before including this table"
#endif

/**
 * Once per frame, the logic tick.
 *
 * @param float dt : seconds since the previous frame
 * @param uint32 timeMs : the frame timestamp in milliseconds
 */
WXL_SCRIPT_HOOK(OnUpdate, (float dt, uint32_t timeMs), (a.dt, a.timeMs))

/**
 * The world finished loading; the player is in-world.
 *
 * @param uint32 mapId : the map entered
 */
WXL_SCRIPT_HOOK(OnWorldEnter, (uint32_t mapId), (a.mapId))

/**
 * The world is being torn down; the map being left is still loaded.
 *
 * @param uint32 mapId : the map being left
 */
WXL_SCRIPT_HOOK(OnWorldLeave, (uint32_t mapId), (a.mapId))

/**
 * A window message arrived.
 *
 * @param uint32 message : the window message
 * @param uintptr wparam
 * @param uintptr lparam
 * @param bool& handled : set true to swallow the message; the game never sees it
 */
WXL_SCRIPT_HOOK(OnInput, (uint32_t message, uintptr_t wparam, uintptr_t lparam, bool& handled), (a.message, a.wparam, a.lparam, *a.handled))

/**
 * A mouse click resolved to a point or an object in the world. Does not fire when a UI handler
 * consumed the click.
 *
 * @param WorldClickArgs click : message, hitType (2 M2 or doodad, 3 terrain or WMO), x y z, objLo objHi
 */
WXL_SCRIPT_HOOK(OnWorldClick, (const events::WorldClickArgs& click), (a))

/**
 * The target-set API applied a new target; the GUID is read through wxl::game.
 *
 * @param void* scriptState : the script state the call ran on
 */
WXL_SCRIPT_HOOK(OnTargetChanged, (void* scriptState), (a.scriptState))

/**
 * A UI or world sound is about to play; the sound id or name is on the script stack.
 *
 * @param void* scriptState : the script state the call ran on
 */
WXL_SCRIPT_HOOK(OnSoundPlay, (void* scriptState), (a.scriptState))
